# Configuración de ocr-mcp. Copiar a .env (que no se versiona) y completar.
# Significado de cada variable: docs/entorno.md.

# --- Core ---------------------------------------------------------------
# Dirección de ocr-core vista desde el servidor (en Docker, la del host o la red).
OCR_CORE_URL=http://127.0.0.1:18012
# Token de este servidor ante el core. Se genera junto con su hash; el hash se
# registra en el core como OCR_CORE_CLIENT_MCP (README.md, "Requisitos").
OCR_CORE_TOKEN=

# --- Servidor -----------------------------------------------------------
# URL con la que los clientes llegan al servidor (https salvo en 127.0.0.1).
OCR_MCP_PUBLIC_URL=http://127.0.0.1:18040
OCR_MCP_PORT=18040
OCR_MCP_DATA_DIR=./datos

# --- Panel /admin ---------------------------------------------------------
OCR_MCP_ADMIN_USER=admin
# Generar con: ocr-mcp hash-password
OCR_MCP_ADMIN_PASSWORD_HASH=

# --- Opcionales -----------------------------------------------------------
# Prefijos de URL que el servidor puede descargar, separados por coma (vacío: apagado).
#OCR_MCP_ALLOWED_URL_PREFIXES=
# Límites por documento (sin valor por defecto: manda el límite del core).
#OCR_MCP_MAX_UPLOAD_BYTES=
#OCR_MCP_MAX_PAGES=
# Vigencias.
#OCR_MCP_ACCESS_TOKEN_TTL_MIN=60
#OCR_MCP_REFRESH_TOKEN_TTL_DAYS=30
#OCR_MCP_LINK_TTL_MIN=30
